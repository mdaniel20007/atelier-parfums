# Conexión a Postgres (Supabase → Project Settings → Database → Connection string → "Transaction pooler", puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU-CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Secreto para firmar la sesión del administrador (mínimo 32 caracteres al azar)
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase Storage para las fotos (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fotos

# Dominio final (para vistas previas en redes)
NEXT_PUBLIC_SITE_URL=https://atelierparfums.com

# Inicio de sesión de clientes con Google (opcional). Sin esta variable, la tienda funciona sin cuentas.
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente de OAuth (Aplicación web)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
